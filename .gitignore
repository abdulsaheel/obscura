# Hardhat
# ---------------------------------------------------------------------------
cache/
artifacts/
typechain/
typechain-types/

# ---------------------------------------------------------------------------
# Circuit artifacts (large / regenerable via `cd circuits && npm run build-all`)
#   Trusted setup, constraint systems, witnesses and the circom JS witness
#   generator are all reproducible and must NOT rebloat the repo.
# ---------------------------------------------------------------------------
*.ptau
*.zkey
*.r1cs
*.sym
*.wtns
circuits/private-transfer_js/

# ---------------------------------------------------------------------------
# Runtime proof artifacts — KEEP TRACKED.
#   Needed by the frontend at runtime AND by CI proof tests
#   (scripts/lib/proof.js falls back to these when circuits/ is unbuilt).
#   These negations override the broad *.zkey rule above.
# ---------------------------------------------------------------------------
!frontend/public/circuits/private-transfer.wasm
!frontend/public/circuits/private-transfer_final.zkey
!frontend/public/circuits/witness_calculator.js

