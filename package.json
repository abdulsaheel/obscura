{
  "name": "obscura-private-transfers",
  "version": "1.0.0",
  "description": "Private transfer system using ZK-SNARKs",
  "private": true,
  "workspaces": [
    "circuits",
    "frontend",
    "indexer"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:indexer": "npm test --workspace indexer",
    "build:circuit": "cd circuits && npm run build-all",
    "build:frontend": "npm run build --workspace frontend",
    "build:indexer": "npm run build --workspace indexer",
    "generate-verifier": "cd circuits && npm run generate-verifier",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:sepolia": "hardhat verify --network sepolia",
    "start:indexer": "npm start --workspace indexer",
    "dev:indexer": "npm run dev --workspace indexer",
    "start:frontend": "npm run dev --workspace frontend"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abdulsaheel/obscura.git"
  },
  "bugs": {
    "url": "https://github.com/abdulsaheel/obscura/issues"
  },
  "homepage": "https://github.com/abdulsaheel/obscura#readme",
  "license": "MIT",
  "author": "Abdul Saheel",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "circomlib": "^2.0.5",
    "ffjavascript": "^0.3.1",
    "poseidon-js": "^0.1.3",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^17.2.3",
    "hardhat": "^2.26.3"
  }
}
