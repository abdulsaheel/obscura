# Obscura — root environment (Hardhat deploy/test)
# Copy to .env and fill in. NEVER commit .env.

# RPC endpoint for the target network
SEPOLIA_RPC_URL=https://1rpc.io/sepolia

# Funded deployer private key (no 0x prefix). Used only for deployment.
# Use a throwaway key for testnet. Keep this secret.
PRIVATE_KEY=

# Optional: for `hardhat verify` contract verification on Etherscan
ETHERSCAN_API_KEY=
